# cp .env.example .env 후 값을 채운다. 비워 둔 값은 application.yml 기본값을 쓴다.

# DB (docker compose 에서는 DB_HOST=postgres 로 덮어쓴다)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=scoophub
DB_USER=scoophub
DB_PASSWORD=

ENABLE_SCHEDULER=true

# LLM (Chat Completions 호환 API. 뉴스 요약은 LLM_API_URL 에 전체 경로 필요)
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-2.0-flash-001

# YouTube
YOUTUBE_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Auth (Google OAuth + JWT)
ALLOWED_EMAILS=user@example.com
SUPER_EMAILS=user@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32바이트 이상이어야 기동된다 (예: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRE_HOURS=24
AUTH_REDIRECT_URL=http://localhost:20020/auth/callback
CORS_ORIGINS=http://localhost:20020
OAUTH_REDIRECT_URI=http://localhost:20010/api/auth/callback
# Swagger 테스트용 인증 바이패스 — 로컬 전용, 운영에서 절대 사용 금지
#AUTH_BYPASS=true

# Alpaca 뉴스 (운영 절차는 NEWS.md 참고). WebSocket 은 단일 인스턴스에서만 켠다.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_STREAM_ENABLED=false
# 생략하면 ALPACA_STREAM_ENABLED 를 따른다. 저장된 pending 기사만 처리하려면 따로 켠다.
ALPACA_WORKER_ENABLED=false
ALPACA_BURST_THRESHOLD=3
ALPACA_BURST_EXCLUDED_SYMBOLS=SPY,BTCUSD
