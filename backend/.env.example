# Existing DB/auth/Telegram/LLM settings are configured separately in .env.
# Generate fresh keys in Alpaca; never reuse the keys exposed during experiments.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_STREAM_ENABLED=false
# Defaults to ALPACA_STREAM_ENABLED. Enable independently to replay persisted pending rows.
ALPACA_WORKER_ENABLED=false
ALPACA_BURST_THRESHOLD=3
ALPACA_BURST_EXCLUDED_SYMBOLS=SPY,BTCUSD
